# IRIS Frontend Environment Configuration
# API Base URL for the FastAPI backend (no trailing slash)
# Standardized to localhost to preserve same-site cookie delivery with Vite (http://localhost:5173)
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (matches GOOGLE_CLIENT_ID in backend .env)
# Create at https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
