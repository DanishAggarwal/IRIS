# Database configuration
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_password
POSTGRES_DB=iris_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://iris:iris_password@localhost:5433/iris_db

# Gemini API configuration
GEMINI_API_KEY=

# OCR model selection (vision-capable models required)
GEMINI_OCR_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_OCR_MODEL_FALLBACK=gemini-3.1-flash-lite

# Generation model selection
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# API configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
