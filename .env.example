# Database configuration
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_password
POSTGRES_DB=iris_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://iris:iris_password@localhost:5433/iris_db

# Gemini API configuration
GEMINI_API_KEY=

# OCR model selection (vision-capable models required)
GEMINI_OCR_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_OCR_MODEL_FALLBACK=gemini-3.1-flash-lite

# Generation model selection (automatic fallback on rate limit / quota exhaustion)
GEMINI_GENERATION_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_GENERATION_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# API configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Application environment: defaults to 'production' if unset.
# Set explicitly to 'development' for local development and to enable local mock authentication.
APP_ENV=development

# Google Authentication & User Authorization
# Your Google OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
# Comma-separated list of allowed institutional email domains
ALLOWED_EMAIL_DOMAINS=pec.edu.in
# Comma-separated allowlist of personal administrator emails (override institutional domain restriction)
ADMIN_EMAILS=
# Session cookie settings
SESSION_COOKIE_NAME=iris_session
SESSION_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
